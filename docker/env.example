# BovinBI LLM API Key 本机配置(此文件绝不提交 git,已在 .gitignore)
# 用法:复制本文件为 .env 并填入你的 Key,./start-all.sh 自动读取(compose 原生支持)
#   cp docker/env.example docker/.env  然后编辑
#
# 任何 OpenAI 兼容端点均可:DeepSeek / 通义千问 / GLM / OpenAI

# ---- 必填:点亮 LLM(Java 引擎 + Python Agent 共用同一把 Key) ----
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选:端点与模型(默认 DeepSeek) ----
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
BOVIN_LLM_PROVIDER=openai
